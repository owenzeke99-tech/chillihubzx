local TweenService = game:GetService("TweenService")

-- Configuration
local CorrectKey = "ChilliHubKeyJalapwowjwnkwowBakqlwowjnekwie"
local ScriptURL = "https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"
local GetKeyURL = "https://link4m.net/O8c0IK"
local SaveFileName = "ChilliHub_KeyData.json"
local KeyDuration = 86400 -- 24 hours in seconds

-- Auto Check Saved Key Function
local HttpService = game:GetService("HttpService")

local function SaveKeyData(key)
    if writefile then
        local data = {
            Key = key,
            Timestamp = os.time()
        }
        writefile(SaveFileName, HttpService:JSONEncode(data))
    end
end

local function LoadSavedKey()
    if readfile and isfile and isfile(SaveFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SaveFileName))
        end)
        if success and result and result.Key and result.Timestamp then
            if (os.time() - result.Timestamp) < KeyDuration then
                if result.Key == CorrectKey then
                    return true
                end
            end
        end
    end
    return false
end

-- If key is already valid, directly load main script without showing UI
if LoadSavedKey() then
    loadstring(game:HttpGet(ScriptURL))()
    return
end

