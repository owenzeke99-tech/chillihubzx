-- Modern Notification Animation Function
local activeNotifThread = nil
local function ShowModernNotification(message, color, strokeColor)
    if activeNotifThread then
        task.cancel(activeNotifThread)
    end
    
    activeNotifThread = task.spawn(function()
        NotifLabel.Text = message
        NotifLabel.TextColor3 = color
        NotifBadge.BackgroundColor3 = strokeColor:Lerp(Color3.fromRGB(0,0,0), 0.7)
        NotifStroke.Color = strokeColor
        
        NotifBadge.Position = UDim2.new(0.08, 0, 0.80, 0)
        
        local tweenInInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(NotifBadge, tweenInInfo, {BackgroundTransparency = 0.2, Position = UDim2.new(0.08, 0, 0.75, 0)}):Play()
        TweenService:Create(NotifStroke, tweenInInfo, {Transparency = 0.3}):Play()
        TweenService:Create(NotifLabel, tweenInInfo, {TextTransparency = 0}):Play()
        
        task.wait(2.5)
        
        local tweenOutInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        TweenService:Create(NotifBadge, tweenOutInfo, {BackgroundTransparency = 1, Position = UDim2.new(0.08, 0, 0.77, 0)}):Play()
        TweenService:Create(NotifStroke, tweenOutInfo, {Transparency = 1}):Play()
        TweenService:Create(NotifLabel, tweenOutInfo, {TextTransparency = 1}):Play()
    end)
end

-- Shake UI Animation
local isShaking = false
local function ShakeUI()
    if isShaking then return end
    isShaking = true
    
    TweenService:Create(InputStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 50, 50)}):Play()
    
    local originalPos = UDim2.new(0.5, -200, 0.5, -145)
    local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true)
    local offsets = { -12, 12, -8, 8, -5, 5, 0 }
    
    for _, offset in ipairs(offsets) do
        local targetPos = UDim2.new(0.5, -200 + offset, 0.5, -145)
        local tween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
        tween:Play()
        tween.Completed:Wait()
    end
    
    MainFrame.Position = originalPos
    TweenService:Create(InputStroke, TweenInfo.new(0.4), {Color = Color3.fromRGB(130, 35, 40)}):Play()
    isShaking = false
end

-- Get Key Click Event
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GetKeyURL)
        ShowModernNotification("Link copied to clipboard!", Color3.fromRGB(120, 220, 255), Color3.fromRGB(0, 150, 255))
    else
        ShowModernNotification("Clipboard function not supported!", Color3.fromRGB(255, 180, 80), Color3.fromRGB(255, 140, 0))
    end
end)

-- Check Key Click Event
CheckKeyBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == CorrectKey then
        SaveKeyData(CorrectKey)
        ShowModernNotification("Access Granted! Loading Chilli Hub...", Color3.fromRGB(120, 255, 160), Color3.fromRGB(0, 220, 100))
        
        task.wait(0.8)
        ScreenGui:Destroy()
        loadstring(game:HttpGet(ScriptURL))()
    else
        ShowModernNotification("Invalid Key! Input cleared.", Color3.fromRGB(255, 100, 100), Color3.fromRGB(255, 50, 50))
        
        KeyInput.Text = ""
        task.spawn(ShakeUI)
    end
end)
